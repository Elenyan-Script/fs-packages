{
    "name": "@script-development/ui-inputs",
    "version": "0.13.0",
    "description": "Headless, themeable Vue 3 UI components — form inputs (field, label, error, text/number/date input, textarea, select, checkbox/radio/switch) plus keyboard-correct interactive controls (pressable, disclosure) — styled entirely through --ui-* CSS custom properties.",
    "homepage": "https://packages.script.nl/packages/ui-inputs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/script-development/fs-packages.git",
        "directory": "packages/ui-inputs"
    },
    "files": [
        "dist",
        "styles.css"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./style.css": "./styles.css"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "tsdown",
        "lint:pkg": "publint && attw --pack",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "echo 'ui-inputs: mutation testing is NOT wired (WR-0897). This is a stub, not a pass — src/composables/useListbox.ts and src/internal/*.ts are real .ts Stryker would mutate. Behaviour is guarded by the 100% coverage gate alone.'",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@floating-ui/vue": "^2.0.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.11.6",
        "unplugin-vue": "^7.2.0",
        "vue": "^3.5.41",
        "vue-tsc": "^3.3.11"
    },
    "peerDependencies": {
        "vue": "^3.5.41"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
